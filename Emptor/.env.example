NIM_API_KEY=your_nvidia_nim_key_here
MERCATOR_ENDPOINT=http://localhost:8000
DEFAULT_BUDGET_INR=1500

# Optional: override the NVIDIA NIM chat model. build.nvidia.com rotates
# preview models often (a decommissioned one returns HTTP 404/410), so this
# is a .env knob rather than a code change. Default: openai/gpt-oss-20b
# (verified against a real account 2026-09-01). Any model on the account's
# /v1/models list that returns clean JSON in message.content works.
# NIM_MODEL=openai/gpt-oss-20b

# Optional: where Fides (the tamper-evident trust ledger) writes Emptor's
# events. Defaults to ./fides_ledger.db if unset.
FIDES_DB_PATH=./fides_ledger.db
