# Local LLM via Ollama (https://ollama.com). Once, before first run:
#   ollama serve
#   ollama pull qwen2.5:7b-instruct
#   ollama pull qwen2.5:3b-instruct
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_MODEL_FALLBACK=qwen2.5:3b-instruct
# LLM_API_KEY=          # only for a hosted provider (OpenAI, NVIDIA NIM, ...)
#
# To point at a hosted provider instead of Ollama, e.g. NVIDIA NIM:
#   LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   LLM_MODEL=<a model on that account's /v1/models list>
#   LLM_API_KEY=<your key>
# Note: response_format:json_object support is per-model on hosted
# providers; a reasoning model that leaks chain-of-thought into the
# response may need a decide.py tweak.

MERCATOR_ENDPOINT=http://localhost:8000
DEFAULT_BUDGET_INR=1500

# Optional: where Fides (the tamper-evident trust ledger) writes Emptor's
# events. Defaults to ./fides_ledger.db if unset.
FIDES_DB_PATH=./fides_ledger.db
