# Forum - the Mercatus demo dashboard. Copy to .env and fill in.
# Forum is a test-mode demo layer; it never handles real money.

# Razorpay TEST-mode credentials - the SAME values as Mercator/.env.
# Forum needs its own client only for on-demand payment-status checks.
RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_MODE=test

# Where Forum serves the dashboard.
FORUM_HOST=127.0.0.1
FORUM_PORT=8100

# The rest default to the monorepo layout; override only if you moved things.
# MERCATOR_DIR=../Mercator
# MERCATOR_ENDPOINT=http://127.0.0.1:8000/mcp
# MERCATOR_LEDGER_DB=../Mercator/ledger.db
# MERCATOR_SPEND_DB=../Mercator/spend_tracker.db
# FORUM_LEDGER_DB=./forum_ledger.db     # Emptor-side Fides events for the demo

# The local LLM is read from the shared Emptor config (LLM_BASE_URL / LLM_MODEL
# / LLM_MODEL_FALLBACK in Emptor/.env, defaulting to local Ollama qwen2.5).
