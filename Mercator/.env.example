RAZORPAY_KEY_ID=rzp_test_your_key_here
RAZORPAY_KEY_SECRET=your_secret_here
RAZORPAY_MODE=test
SPEND_CAP_INR=1500
ALLOWED_CATEGORIES=books,toys,stationery
MERCATOR_PORT=8000
# MCP_TRANSPORT=streamable-http   # uncomment to serve HTTP instead of stdio (needed for Emptor)
# CUMULATIVE_SPEND_CAP_INR=       # required when RAZORPAY_MODE=live; optional cap in test mode
# CUMULATIVE_SPEND_WINDOW_HOURS=24
# PAYMENT_LINK_EXPIRE_HOURS=      # required when RAZORPAY_MODE=live; optional in test mode
# MAX_PENDING_PAYMENT_LINKS=5

# --- autopay (tiered-autonomy envelope) ---------------------------------
# Off unless AUTOPAY_ENABLED=true (exact 'true'/'false'; anything else is a
# startup failure). When on, a sub-threshold purchase whose category is on
# the stricter autopay allowlist is settled by drawing a prepaid balance --
# no human click, no gateway call. Everything else falls back to a
# human-paid Payment Link. Fund the balance once with: uv run mercator-topup <rupees>
# AUTOPAY_ENABLED=false
# AUTOPAY_THRESHOLD_INR=800            # must be strictly below SPEND_CAP_INR
# AUTOPAY_ALLOWED_CATEGORIES=books     # must be a subset of ALLOWED_CATEGORIES
# AUTOPAY_MAX_BALANCE_INR=5000         # ceiling mercator-topup will not exceed
